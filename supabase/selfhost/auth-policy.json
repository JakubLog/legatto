{
  "env": {
    "GOTRUE_DISABLE_SIGNUP": "true",
    "GOTRUE_EXTERNAL_ANONYMOUS_USERS_ENABLED": "false",
    "GOTRUE_EXTERNAL_EMAIL_ENABLED": "true",
    "GOTRUE_EXTERNAL_PHONE_ENABLED": "false",
    "GOTRUE_HOOK_SEND_EMAIL_ENABLED": "true",
    "GOTRUE_JWT_EXP": "3600",
    "GOTRUE_MAILER_AUTOCONFIRM": "false",
    "GOTRUE_MAILER_SECURE_EMAIL_CHANGE_ENABLED": "true",
    "GOTRUE_MAILER_SUBJECTS_INVITE": "Zaproszenie do systemu biura poselskiego",
    "GOTRUE_MFA_TOTP_ENROLL_ENABLED": "true",
    "GOTRUE_MFA_TOTP_VERIFY_ENABLED": "true",
    "GOTRUE_PASSWORD_MIN_LENGTH": "12",
    "GOTRUE_PASSWORD_REQUIRED_CHARACTERS": "abcdefghijklmnopqrstuvwxyz:ABCDEFGHIJKLMNOPQRSTUVWXYZ:0123456789:!@#$%^&*()_+-=[]{};'\\\\:\"|<>?,./`~",
    "GOTRUE_SECURITY_REFRESH_TOKEN_REUSE_INTERVAL": "10",
    "GOTRUE_SECURITY_REFRESH_TOKEN_ROTATION_ENABLED": "true",
    "GOTRUE_SECURITY_UPDATE_PASSWORD_REQUIRE_CURRENT_PASSWORD": "true",
    "GOTRUE_SECURITY_UPDATE_PASSWORD_REQUIRE_REAUTHENTICATION": "true",
    "GOTRUE_SESSIONS_INACTIVITY_TIMEOUT": "168h",
    "GOTRUE_SESSIONS_TIMEBOX": "720h"
  },
  "feature_env": {
    "GOTRUE_PASSWORD_HIBP_ENABLED": {
      "default": "true",
      "feature": "hibp"
    }
  },
  "not_env": {
    "mailer_templates_invite_content": "VPS nie używa szablonów GoTrue: maile Auth wysyła Send Email Hook aplikacji (server/auth-email-hook.ts) z supabase/templates/invite.html"
  },
  "origin_env": {
    "GOTRUE_SITE_URL": "{origin}",
    "GOTRUE_URI_ALLOW_LIST": "{origin}/login,{admin_origin}/login"
  },
  "schema": "legatto-auth-policy/1"
}
