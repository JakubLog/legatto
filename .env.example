# Jedna instancja = jeden poseł: każda instancja ma własny projekt Supabase, projekt Vercel i domenę.
# Pełna lista kroków: README.md -> "Nowa instancja".

# =====================================================
# Klient (Vite) - publiczne zmienne (prefix VITE_)
# Lokalnie: .env.local; produkcja: Vercel -> Environment Variables
# =====================================================

# Supabase. VITE_SUPABASE_URL jest WYMAGANY także przy buildzie: z niego powstaje CSP instancji (<meta> w index.html,
# vite.config.ts → instanceCsp). Build bez poprawnego adresu (https; http tylko localhost) kończy się błędem.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Cloudflare Turnstile (formularz zgłoszeń) - site key witryny założonej dla domeny tej instancji.
# WYMAGANE: bez klucza formularz pokazuje "Formularz jest chwilowo niedostępny". Lokalnie: testowy site key Cloudflare
# działa tylko razem z testowym secret key w Edge Function (z sekretem produkcji zgłoszenie dostanie 403).
# Publiczny: trafia do bundla klienta (envPrefix w vite.config.ts).
# TURNSTILE_KEY=your-turnstile-site-key

# Tytuł aplikacji w index.html (karta przeglądarki przed JS, podglądy w mediach społecznościowych) i manifeście PWA.
# Build-time. Domyślnie "Biuro Poselskie".
# VITE_APP_TITLE=Biuro Poselskie | Jan Kowalski

# Opcjonalne: adres e-mail kontaktu w sprawie resetu 2FA (ekran kodu 2FA). Bez niego ekran każe zwrócić się
# do Posła/Administratora instancji.
# VITE_SUPPORT_EMAIL=pomoc@biuro.example.pl

# Tylko dev: serwer `pnpm dev` słucha domyślnie na localhost (uruchamia api/ z kluczem service_role).
# Dostęp z sieci lokalnej (np. test na telefonie): VITE_DEV_HOST=0.0.0.0
# VITE_DEV_HOST=0.0.0.0

# Tylko lokalny Supabase (`supabase start` czyta je z .env.local, supabase/config.toml → env(...)).
# Bez nich site_url lokalnego Auth jest dosłownie "env(INSTANCE_SITE_URL)" i linki z maili nie działają.
# Produkcja: NIE ustawiaj - Auth instancji konfiguruje scripts/instances/provision.mjs.
# INSTANCE_SITE_URL=http://localhost:8080
# INSTANCE_LOGIN_URL=http://localhost:8080/login

# =====================================================
# Vercel Functions (api/) - NIE w VITE_
# Ustaw w: Vercel -> Environment Variables
# =====================================================

# Dodatki instancji - włącza operator (nie panel aplikacji). Wartości: on | off.
# Brak albo inna wartość = off (błąd w logu). Czytane w api/ (runtime) i przy buildzie frontendu
# (vite.config.ts → define), więc zmiana wymaga ponownego wdrożenia. Ustaw PRZED wdrożeniem.
# INSTANCE_AI   - PoliAI, raporty AI budżetu, OCR załączników, MCP i OAuth dla Claude. off = /api/poliai,
#                 /api/mcp, /api/oauth/* i /.well-known/oauth-authorization-server zwracają 404 AI_DISABLED, UI ukryte.
# INSTANCE_EMAIL - e-maile powiadomień (Resend). off = brak zapytań do Resend; push działa dalej.
#                 Maile Supabase Auth (zaproszenia, linki logowania) idą przez SMTP Auth i tej flagi nie dotyczą.
# INSTANCE_AI=off
# INSTANCE_EMAIL=off

# Opcjonalne (przy INSTANCE_AI=on): klucz i modele AI operatora - pierwszeństwo przed Integracje → AI.
# Z AI_API_KEY panel pokazuje "Klucz AI ustawia operator instancji", nie czyta klucza z Vault i nie pozwala
# wybrać modelu (koszt idzie na konto operatora): bez AI_MODEL używany jest model domyślny poniżej.
# AI_API_KEY=sk-ant-...
# AI_MODEL=claude-sonnet-4-6
# AI_FAST_MODEL=claude-haiku-5-5

# WYMAGANE: klucz service_role (api/_lib/supabase.ts rzuca błąd bez niego).
# SUPABASE_SERVICE_ROLE_KEY=...
# Opcjonalne - domyślnie VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY (brak obu = błąd przy pierwszym żądaniu).
# SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# SUPABASE_ANON_KEY=your-anon-key

# Kanoniczny publiczny adres instancji (OAuth issuer, strona zgody OAuth, logo MCP, adres wysyłki powiadomień). Opcjonalne: domyślnie https://$VERCEL_PROJECT_PRODUCTION_URL (zmienna systemowa
# Vercela = główna domena produkcyjna projektu), lokalnie adres z żądania.
# WYMAGANE, gdy projekt ma kilka domen produkcyjnych - wtedy wskaż tę główną.
# OAUTH_ISSUER=https://biuro.example.pl

# WYMAGANE: sekret cronów (/api/cron/sync-ics, /api/cron/poliai-purge, /api/cron/notifications).
# Bez niego crony odpowiadają 503 (błąd w logu), a retencja PoliAI, synchronizacja ICS i podsumowania stoją.
# Wygeneruj: `openssl rand -hex 32`
# CRON_SECRET=random-hex-string

# Powiadomienia (e-mail Resend + web push): klucz Resend i nadawcę ustawia Poseł/Administrator
# w Integracje → Powiadomienia; klucze VAPID generuje serwer.
# Opcjonalne nadpisania (testy lokalne): RESEND_API_URL (atrapa Resend),
# NOTIFICATIONS_DISPATCH_URL - adres wysyłki wołany przez pg_net; domyślnie <adres instancji>/api/notifications?op=dispatch
# (np. lokalnie http://host.docker.internal:8080/api/notifications?op=dispatch)

# =====================================================
# Supabase Edge Functions - NIE w VITE_
# Ustaw przez: supabase secrets set NAZWA=wartosc
# =====================================================

# WYMAGANE: originy frontendu tej instancji dozwolone w CORS (lista po przecinku).
# Bez sekretu (lokalny `supabase start`) dozwolone są tylko localhost:8080 i localhost:3000; ustawiona lista
# zastępuje je w całości (produkcja bez localhost).
# ALLOWED_ORIGINS=https://biuro.example.pl

# Opcjonalne: hosty, na których działa widget Turnstile formularza zgłoszeń (lista po przecinku).
# Domyślnie: hosty z ALLOWED_ORIGINS (bez ALLOWED_ORIGINS: localhost). Ustawiona lista zastępuje domyślną w całości.
# TURNSTILE_ALLOWED_HOSTNAMES=biuro.example.pl

# WYMAGANE: adres strony logowania tej instancji (linki w mailach z zaproszeniem / resetem hasła).
# Bez niego funkcje admin-* wysyłające maile (zaproszenie, link logowania/resetu, reset 2FA, wylogowanie) zwracają 500.
# AUTH_REDIRECT_URL=https://biuro.example.pl/login

# WYMAGANE: Cloudflare Turnstile - secret key tej samej witryny co TURNSTILE_KEY
# TURNSTILE_SECRET=your-turnstile-secret-key

# WYMAGANE: sól do hashowania IP zgłoszeń publicznych (RODO - nie przechowujemy raw IP).
# Wygeneruj losowy 256-bitowy ciąg, np. `openssl rand -hex 32`
# PUBLIC_SUBMISSION_IP_SALT=random-256-bit-hex-string
